# Application Settings
PROJECT_NAME="AI Voice IT Helpdesk Agent"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (Supports SQLite local file or PostgreSQL/Supabase)
# SQLite default for local zero-cost testing:
DATABASE_URL="sqlite+aiosqlite:///./helpdesk.db"
# PostgreSQL / Supabase example:
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/helpdesk_db"

# Security & JWT Token Authentication
SECRET_KEY="super-secret-development-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# GPT-5 / OpenAI Integration (Optional: Mock engine is enabled if empty)
OPENAI_API_KEY=""
USE_MOCK_LLM=True

# ElevenLabs Integration (Optional: Local webhook simulator enabled if empty)
ELEVENLABS_API_KEY=""
ELEVENLABS_AGENT_ID=""
ELEVENLABS_WEBHOOK_SECRET="sample-webhook-secret-key"
